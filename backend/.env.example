# ==========================================
# LuminaLearn Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/LuminaLearn?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_super_strong_jwt_secret_key_here

# Frontend Application URL (for CORS & email links)
FRONTEND_URL=https://luminalearn.edu.lk

# Storage Path (Absolute path on server for file uploads, default: backend/storage)
STORAGE_PATH=

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Lumina AI Chatbot (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery (Brevo / Sendinblue API)
BREVO_API_KEY=your_brevo_api_v3_key_here
BREVO_FROM_EMAIL=mail@luminalearn.edu.lk
BREVO_FROM_NAME=LuminaLearn

# SMS Gateway (Text.lk)
TEXTLK_API_TOKEN=your_textlk_api_token_here
TEXTLK_SENDER_ID=LuminaLearn
